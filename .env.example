# WISHAM environment — copy this to .env.local and fill in the values.
# .env.local is gitignored and never committed.

# Neon Postgres (server-side only)
DATABASE_URL=""

# Public URL of the site (Paystack callback + email download links)
APP_URL="http://localhost:3000"

# Paystack — test keys for development, live keys for production
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# NGN works out of the box for Paystack merchants; switch to USD once
# International Payments is enabled in the Paystack dashboard.
PAYSTACK_CURRENCY="NGN"

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="WISHAM <onboarding@resend.dev>"

# Admin account seeded on first run
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
JWT_SECRET=""

# Cloudinary (beat + stem file storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="wisham"
